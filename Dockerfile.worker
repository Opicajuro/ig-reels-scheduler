FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates python3-pip chromium \
  && pip install --no-cache-dir --break-system-packages yt-dlp \
  && rm -rf /var/lib/apt/lists/*

# Captions render with this Chrome. Whisper is not in the image: captions need WHISPER_BIN and WHISPER_MODEL set.
ENV CHROME_PATH=/usr/bin/chromium

RUN corepack enable

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm prisma generate

CMD ["pnpm", "worker"]
