generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime    @default(now())
  accounts      IgAccount[]
  auditLogs     AuditLog[]
  clipProjects  ClipProject[]
  aiVideoJobs   AiVideoJob[]
  slideshowJobs SlideshowJob[]
  profileLinks  ProfileLink[]
  guideLinks    GuideLink[]
  ytAccounts    YtAccount[]
}

enum AccountStatus {
  active
  reauth_required
  revoked
}

model IgAccount {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  igUserId    String        @unique
  username    String
  accountType String
  timezone    String        @default("UTC")
  status      AccountStatus @default(active)
  // pausedUntil is a pause the owner chose; rateLimitedUntil is a pause Meta's rate limit asked for.
  pausedUntil      DateTime?
  rateLimitedUntil DateTime?
  lockedUntil DateTime?
  createdAt   DateTime      @default(now())
  token       IgToken?
  media       Media[]
  posts       Post[]
}

model IgToken {
  accountId       String    @id
  account         IgAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ciphertext      Bytes
  iv              Bytes
  authTag         Bytes
  expiresAt       DateTime
  lastRefreshedAt DateTime?
}

enum MediaStatus {
  uploaded
  transcoding
  ready
  failed
}

enum AudioSource {
  original
  licensed
  from_source
  unknown
}

model Media {
  id         String      @id @default(cuid())
  accountId  String
  account    IgAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rawKey     String
  reelKey    String?
  coverKey   String?
  durationMs Int?
  width      Int?
  height     Int?
  status     MediaStatus @default(uploaded)
  error      String?
  audioSource     AudioSource @default(unknown)
  sourceProjectId String?
  // The clip it was scheduled from, for showing where else that clip was posted. Not a relation: deleting the clip
  // never touches a post.
  sourceClipId    String?
  posts      Post[]
}

enum PostStatus {
  scheduled
  container_created
  published
  failed
  canceled
}

model Post {
  id          String        @id @default(cuid())
  accountId   String
  account     IgAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mediaId     String
  media       Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  caption     String
  shareToFeed Boolean       @default(true)
  // Sent as is_ai_generated, so Instagram shows its AI info label on the Reel.
  aiGenerated Boolean       @default(false)
  scheduledAt DateTime
  status      PostStatus    @default(scheduled)
  containerId String?
  queueJobId  String?
  igMediaId   String?
  permalink   String?
  attempts    Int           @default(0)
  lastError   String?
  rightsConfirmedAt DateTime?
  attemptLogs PublishAttempt[]
  insights    Insight[]
}

enum AttemptStep {
  create
  poll
  publish
  quota
}

model PublishAttempt {
  id        String      @id @default(cuid())
  postId    String
  post      Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  step      AttemptStep
  httpStatus Int?
  errorCode Int?
  response  Json
  at        DateTime    @default(now())
}

// A YouTube channel connected with the owner's own Google Cloud OAuth client. The refresh token is sealed with
// TOKEN_ENC_KEY (src/lib/settings.ts) and removed on disconnect.
model YtAccount {
  id           String        @id @default(cuid())
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  channelId    String        @unique
  channelTitle String
  status       AccountStatus @default(active)
  refreshToken String?
  createdAt    DateTime      @default(now())
  posts        YtPost[]
}

enum YtPrivacy {
  public
  unlisted
  private
}

// A clip scheduled as a YouTube Short. container_created means the upload is under way. videoKey is the post's own
// copy of the clip; uploadUrl is the resumable upload session, so a retried job goes on from where the last one
// stopped.
model YtPost {
  id                String     @id @default(cuid())
  ytAccountId       String
  ytAccount         YtAccount  @relation(fields: [ytAccountId], references: [id], onDelete: Cascade)
  videoKey          String
  durationMs        Int
  sourceProjectId   String?
  sourceClipId      String?
  title             String
  description       String
  privacy           YtPrivacy
  madeForKids       Boolean
  // Sent as status.containsSyntheticMedia, YouTube's altered or synthetic content disclosure.
  aiGenerated       Boolean    @default(false)
  scheduledAt       DateTime
  status            PostStatus @default(scheduled)
  queueJobId        String?
  uploadUrl         String?
  videoId           String?
  url               String?
  attempts          Int        @default(0)
  lastError         String?
  rightsConfirmedAt DateTime?
  createdAt         DateTime   @default(now())
  insights          YtInsight[]
}

// viewCount, likeCount and commentCount from videos.list, stored as views, likes and comments like Instagram's insights.
model YtInsight {
  id        String   @id @default(cuid())
  ytPostId  String
  ytPost    YtPost   @relation(fields: [ytPostId], references: [id], onDelete: Cascade)
  metric    String
  value     Float
  fetchedAt DateTime @default(now())
}

model Insight {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  metric    String
  value     Float
  fetchedAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  data       Json
  at         DateTime @default(now())
}

enum ClipProjectStatus {
  awaiting_source
  ready
  // "Find highlights" is downloading and analysing the video, then the picked highlights wait in "review".
  picking
  review
  rendering
  done
  failed
}

model ClipProject {
  id              String            @id @default(cuid())
  ownerId         String
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  sourceUrl       String?
  sourceKey       String?
  // When the source video was deleted on the Storage page to free space. The clips stay; finding highlights and
  // making clips again need the video.
  sourceDeletedAt DateTime?
  status          ClipProjectStatus @default(awaiting_source)
  error           String?
  renderStep      String?
  // When the current "Make clips" started, so the page can show how long it has been running.
  renderStartedAt DateTime?
  // A new id for each "Make clips". A clip job carries it, so a job for an earlier render is refused.
  renderId        String?
  // The highlights a render picked, stored before its first clip is made: { renderId, clips: [{ clipId, start,
  // length }] }. A render whose plan is already stored was interrupted, and goes on from the clips it finished.
  renderPlan      Json?
  // The highlights "Find highlights" picked and the person adjusted: [{ start, length }] in seconds. A render that
  // starts with them makes exactly these clips instead of picking its own.
  highlights      Json?
  // The source video's whisper words, [{ text, startMs, endMs }], kept so captions never transcribe it twice.
  transcript      Json?
  durationSeconds Int?
  clipSeconds     Int               @default(30)
  clipCount       Int?
  withCaptions    Boolean           @default(false)
  captionPreset   String?
  captionPosition String            @default("bottom")
  captionUppercase Boolean          @default(false)
  // "default" is the system font the captions have always used. The font also draws the hook and the end card.
  captionFont     String            @default("default")
  // The word-by-word highlight colour.
  captionHighlight String           @default("yellow")
  // One emoji per caption line, picked from a word spoken in it.
  captionEmoji    Boolean           @default(false)
  // "off", "text" (hookText on every clip) or "clipTitle" (each clip's title, kept from the clip it replaces).
  hookMode        String            @default("off")
  hookText        String?
  // The progress bar's colour, or null for no bar.
  progressBar     String?
  // The end card's text, such as "@myhandle", or null for no end card.
  endCardText     String?
  // A track id from the built-in music library (src/clip-engine/music-library.json) mixed under every clip, ducked
  // under speech, or null for none. The volume is a percentage of the track's own level.
  musicTrack      String?
  musicVolume     Int               @default(15)
  // "Tighten pacing": inside each clip, long pauses shrink and lone filler words are cut, by the transcript's words.
  tightenPacing   Boolean           @default(false)
  // "Crop": how the 9:16 picture is taken from the source. "centre", "follow" (follows faces, people and motion, and
  // fits stretches too wide to crop) or "fit" (the whole frame over a blurred fill). Projects made before it keep
  // "centre".
  crop            String            @default("follow")
  // The owner's one "AI videos" project, which holds the AI videos made on the Clips page. It has no source video.
  aiVideos        Boolean           @default(false)
  // The owner's one "Slideshows" project, which holds the slideshows made on the Clips page. It has no source video.
  slideshows      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  clips           Clip[]
}

model Clip {
  id          String      @id @default(cuid())
  projectId   String
  project     ClipProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  // Seconds into the source video. Reviewed highlights move by half seconds.
  start       Float
  length      Float
  storageKey  String
  title       String?
  description String?
  // Made by the AI video engine from a description on the Clips page. Its posts always carry Instagram's AI info
  // label (Post.aiGenerated).
  aiGenerated Boolean     @default(false)
  // The library track mixed into the clip when it was made, so scheduling it can add the track's credit line.
  musicTrack  String?
  // The words captioned on the clip, [{ text, startMs, endMs, lineStart? }] in ms from the clip's start, lineStart
  // marking the first word of each caption line. Null for a clip made without captions or before they were kept.
  words       Json?
  // The clip's cut without captions or extras, kept with its words so the captions can be drawn again without cutting.
  baseKey     String?
  // Counts the clip's files: a re-render uploads the next version under a new key.
  version     Int         @default(1)
  // While its captions are re-rendered: the job's id, its step and the edited words it draws. recaptionError is why
  // the last one failed.
  recaptionId    String?
  recaptionStep  String?
  recaptionWords Json?
  recaptionError String?
  // "Write with AI": while the script writer writes the clip's title, description and hashtags, the job's id (shared by
  // the clips of one bulk job) and its step. aiSuggestion is what it wrote, { title, description, hashtags }, kept until
  // the person uses or discards it; aiWriteError is why the last one failed.
  aiWriteId      String?
  aiWriteStep    String?
  aiSuggestion   Json?
  aiWriteError   String?
  createdAt   DateTime    @default(now())
  aiVideoJob  AiVideoJob? @relation("AiVideoClip")
  // AI intros and B-roll asked for from this clip.
  aiVideoSources AiVideoJob[] @relation("AiVideoSource")
  slideshowJob SlideshowJob?
  links       ClipLink[]
}

// Where a clip was posted outside Localirs (YouTube Shorts, TikTok, …), pasted by the owner. A copy of the clip does not
// get them: they belong to the clip that was posted.
model ClipLink {
  id        String   @id @default(cuid())
  clipId    String
  clip      Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

// The owner's own social profiles, shown on Home and as contact links on the privacy page.
model ProfileLink {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

// Video guides the owner adds in Settings, listed on the Help page.
model GuideLink {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  url       String
  createdAt DateTime @default(now())
}

// The app's settings, edited on /settings: one row, id 1. The Meta app secret and the Resend API key are sealed with
// TOKEN_ENC_KEY (src/lib/settings.ts).
model Setting {
  id                Int     @id @default(1)
  metaAppId         String?
  metaAppSecret     String?
  alertEmail        String?
  resendApiKey      String?
  emailFrom         String?
  // Cloudflare R2, where a post's video is put for Instagram to download. The secret access key is sealed too.
  r2AccountId       String?
  r2AccessKeyId     String?
  r2SecretAccessKey String?
  r2Bucket          String?
  // The owner's own Google Cloud OAuth client, for connecting YouTube channels. The secret is sealed too.
  googleClientId     String?
  googleClientSecret String?
  // The look of the app (src/lib/appearance.ts): a design, Night Spring's colour palette, and a colour shift in degrees.
  design            String  @default("night")
  palette           String  @default("default")
  hue               Int     @default(0)
}

// The H.264 encoder the worker found when it last started: the NVIDIA card's NVENC, AMD graphics' AMF, or x264 on the
// processor. Also the whisper.cpp build it transcribes with, found at its first transcription since that start: the
// Vulkan build on a graphics device (named as Vulkan reports it), or the processor build. Null until then.
model VideoEncoding {
  id                Int          @id @default(1)
  encoder           VideoEncoder
  checkedAt         DateTime     @updatedAt
  transcriber       Transcriber?
  transcriberDevice String?
}

enum VideoEncoder {
  nvenc
  amf
  x264
}

enum Transcriber {
  vulkan
  cpu
}

enum AiEngineStatus {
  not_installed
  installing
  installed
  failed
}

// The offline AI video engine (ComfyUI and the Wan 2.2 model files in <data>\ai): one row, id 1. No row means not
// installed. While installing, the worker writes the step and the percentage every few seconds.
model AiEngine {
  id             Int            @id @default(1)
  status         AiEngineStatus @default(not_installed)
  step           String?
  percent        Int?
  error          String?
  installedBytes BigInt?
  updatedAt      DateTime       @updatedAt
}

enum AiVideoStatus {
  queued
  running
  done
  failed
}

// One AI video asked for on the Clips page. When it is done, clipId is the clip it made in the owner's "AI videos"
// project.
model AiVideoJob {
  id            String        @id @default(cuid())
  ownerId       String
  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  prompt        String
  seconds       Int
  startImageKey String?
  status        AiVideoStatus @default(queued)
  step          String?
  error         String?
  clipId        String?       @unique
  clip          Clip?         @relation("AiVideoClip", fields: [clipId], references: [id], onDelete: SetNull)
  // An intro or B-roll is made from a frame of an existing clip (at seconds into it, for B-roll) and joined to it.
  kind          AiVideoKind   @default(prompt)
  sourceClipId  String?
  sourceClip    Clip?         @relation("AiVideoSource", fields: [sourceClipId], references: [id], onDelete: SetNull)
  at            Float?
  createdAt     DateTime      @default(now())
}

enum AiVideoKind {
  prompt
  intro
  broll
}

// The two offline engines of the slideshows, in <data>\slideshow: "script" (llama.cpp and the Qwen3.5 model) and
// "picture" (stable-diffusion.cpp and the Z-Image Turbo files). No row means not installed. While installing, the
// worker writes the step and the percentage every few seconds.
model SlideshowEngine {
  id             String         @id
  status         AiEngineStatus @default(not_installed)
  step           String?
  percent        Int?
  error          String?
  installedBytes BigInt?
  updatedAt      DateTime       @updatedAt
}

enum SlideshowStatus {
  writing
  draft
  queued
  running
  done
  failed
}

// One slideshow from the Clips page. The script writer fills slides ([{ text, picture, source }]); the person edits it
// as a draft, then it is made into clipId in the owner's "Slideshows" project.
model SlideshowJob {
  id            String          @id @default(cuid())
  ownerId       String
  owner         User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  topic         String
  slideCount    Int
  slides        Json?
  voice         String          @default("af_heart")
  captionPreset String          @default("words")
  // Background music from the built-in library, as on a clip project.
  musicTrack    String?
  musicVolume   Int             @default(15)
  status        SlideshowStatus @default(writing)
  step          String?
  error         String?
  clipId        String?         @unique
  clip          Clip?           @relation(fields: [clipId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
}

// Where the daily backups go (null: the backups folder in the data folder) and whether they copy the clip files too.
model BackupSettings {
  id           Int     @id @default(1)
  folder       String?
  includeClips Boolean @default(false)
}

enum BackupStatus {
  running
  ok
  failed
}

// One backup, scheduled or asked for on /settings: a folder holding the database dump, secrets.json and a manifest.
model Backup {
  id           String       @id @default(cuid())
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?
  path         String
  includeClips Boolean
  status       BackupStatus @default(running)
  sizeBytes    BigInt?
  error        String?
}
