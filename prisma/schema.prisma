generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime    @default(now())
  accounts      IgAccount[]
  auditLogs     AuditLog[]
  clipProjects  ClipProject[]
}

enum AccountStatus {
  active
  reauth_required
  revoked
}

model IgAccount {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  igUserId    String        @unique
  username    String
  accountType String
  timezone    String        @default("UTC")
  status      AccountStatus @default(active)
  // pausedUntil is a pause the owner chose; rateLimitedUntil is a pause Meta's rate limit asked for.
  pausedUntil      DateTime?
  rateLimitedUntil DateTime?
  lockedUntil DateTime?
  createdAt   DateTime      @default(now())
  token       IgToken?
  media       Media[]
  posts       Post[]
}

model IgToken {
  accountId       String    @id
  account         IgAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ciphertext      Bytes
  iv              Bytes
  authTag         Bytes
  expiresAt       DateTime
  lastRefreshedAt DateTime?
}

enum MediaStatus {
  uploaded
  transcoding
  ready
  failed
}

enum AudioSource {
  original
  licensed
  from_source
  unknown
}

model Media {
  id         String      @id @default(cuid())
  accountId  String
  account    IgAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rawKey     String
  reelKey    String?
  coverKey   String?
  durationMs Int?
  width      Int?
  height     Int?
  status     MediaStatus @default(uploaded)
  error      String?
  audioSource     AudioSource @default(unknown)
  sourceProjectId String?
  posts      Post[]
}

enum PostStatus {
  scheduled
  container_created
  published
  failed
  canceled
}

model Post {
  id          String        @id @default(cuid())
  accountId   String
  account     IgAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mediaId     String
  media       Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  caption     String
  shareToFeed Boolean       @default(true)
  scheduledAt DateTime
  status      PostStatus    @default(scheduled)
  containerId String?
  queueJobId  String?
  igMediaId   String?
  permalink   String?
  attempts    Int           @default(0)
  lastError   String?
  rightsConfirmedAt DateTime?
  attemptLogs PublishAttempt[]
  insights    Insight[]
}

enum AttemptStep {
  create
  poll
  publish
  quota
}

model PublishAttempt {
  id        String      @id @default(cuid())
  postId    String
  post      Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  step      AttemptStep
  httpStatus Int?
  errorCode Int?
  response  Json
  at        DateTime    @default(now())
}

model Insight {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  metric    String
  value     Float
  fetchedAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  data       Json
  at         DateTime @default(now())
}

enum ClipProjectStatus {
  awaiting_source
  ready
  rendering
  done
  failed
}

model ClipProject {
  id              String            @id @default(cuid())
  ownerId         String
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  sourceUrl       String?
  sourceKey       String?
  status          ClipProjectStatus @default(awaiting_source)
  error           String?
  renderStep      String?
  durationSeconds Int?
  clipSeconds     Int               @default(30)
  clipCount       Int?
  withCaptions    Boolean           @default(false)
  captionPreset   String?
  captionPosition String            @default("bottom")
  captionUppercase Boolean          @default(false)
  createdAt       DateTime          @default(now())
  clips           Clip[]
}

model Clip {
  id          String      @id @default(cuid())
  projectId   String
  project     ClipProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  start       Int
  length      Int
  storageKey  String
  title       String?
  description String?
  createdAt   DateTime    @default(now())
}

// The app's settings, edited on /settings: one row, id 1. The Meta app secret and the Resend API key are sealed with
// TOKEN_ENC_KEY (src/lib/settings.ts).
model Setting {
  id              Int     @id @default(1)
  metaAppId       String?
  metaAppSecret   String?
  alertEmail      String?
  resendApiKey    String?
  emailFrom       String?
  captionLanguage String  @default("auto")
}
