generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime    @default(now())
  accounts      IgAccount[]
  auditLogs     AuditLog[]
  clipProjects  ClipProject[]
  aiVideoJobs   AiVideoJob[]
  profileLinks  ProfileLink[]
  guideLinks    GuideLink[]
}

enum AccountStatus {
  active
  reauth_required
  revoked
}

model IgAccount {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  igUserId    String        @unique
  username    String
  accountType String
  timezone    String        @default("UTC")
  status      AccountStatus @default(active)
  // pausedUntil is a pause the owner chose; rateLimitedUntil is a pause Meta's rate limit asked for.
  pausedUntil      DateTime?
  rateLimitedUntil DateTime?
  lockedUntil DateTime?
  createdAt   DateTime      @default(now())
  token       IgToken?
  media       Media[]
  posts       Post[]
}

model IgToken {
  accountId       String    @id
  account         IgAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ciphertext      Bytes
  iv              Bytes
  authTag         Bytes
  expiresAt       DateTime
  lastRefreshedAt DateTime?
}

enum MediaStatus {
  uploaded
  transcoding
  ready
  failed
}

enum AudioSource {
  original
  licensed
  from_source
  unknown
}

model Media {
  id         String      @id @default(cuid())
  accountId  String
  account    IgAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rawKey     String
  reelKey    String?
  coverKey   String?
  durationMs Int?
  width      Int?
  height     Int?
  status     MediaStatus @default(uploaded)
  error      String?
  audioSource     AudioSource @default(unknown)
  sourceProjectId String?
  // The clip it was scheduled from, for showing where else that clip was posted. Not a relation: deleting the clip
  // never touches a post.
  sourceClipId    String?
  posts      Post[]
}

enum PostStatus {
  scheduled
  container_created
  published
  failed
  canceled
}

model Post {
  id          String        @id @default(cuid())
  accountId   String
  account     IgAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mediaId     String
  media       Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  caption     String
  shareToFeed Boolean       @default(true)
  // Sent as is_ai_generated, so Instagram shows its AI info label on the Reel.
  aiGenerated Boolean       @default(false)
  scheduledAt DateTime
  status      PostStatus    @default(scheduled)
  containerId String?
  queueJobId  String?
  igMediaId   String?
  permalink   String?
  attempts    Int           @default(0)
  lastError   String?
  rightsConfirmedAt DateTime?
  attemptLogs PublishAttempt[]
  insights    Insight[]
}

enum AttemptStep {
  create
  poll
  publish
  quota
}

model PublishAttempt {
  id        String      @id @default(cuid())
  postId    String
  post      Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  step      AttemptStep
  httpStatus Int?
  errorCode Int?
  response  Json
  at        DateTime    @default(now())
}

model Insight {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  metric    String
  value     Float
  fetchedAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  data       Json
  at         DateTime @default(now())
}

enum ClipProjectStatus {
  awaiting_source
  ready
  rendering
  done
  failed
}

model ClipProject {
  id              String            @id @default(cuid())
  ownerId         String
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  sourceUrl       String?
  sourceKey       String?
  status          ClipProjectStatus @default(awaiting_source)
  error           String?
  renderStep      String?
  // When the current "Make clips" started, so the page can show how long it has been running.
  renderStartedAt DateTime?
  durationSeconds Int?
  clipSeconds     Int               @default(30)
  clipCount       Int?
  withCaptions    Boolean           @default(false)
  captionPreset   String?
  captionPosition String            @default("bottom")
  captionUppercase Boolean          @default(false)
  // The owner's one "AI videos" project, which holds the AI videos made on the Clips page. It has no source video.
  aiVideos        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  clips           Clip[]
}

model Clip {
  id          String      @id @default(cuid())
  projectId   String
  project     ClipProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  start       Int
  length      Int
  storageKey  String
  title       String?
  description String?
  // Made by the AI video engine from a description on the Clips page. Its posts always carry Instagram's AI info
  // label (Post.aiGenerated).
  aiGenerated Boolean     @default(false)
  createdAt   DateTime    @default(now())
  aiVideoJob  AiVideoJob?
  links       ClipLink[]
}

// Where a clip was posted outside Localirs (YouTube Shorts, TikTok, …), pasted by the owner. A copy of the clip does not
// get them: they belong to the clip that was posted.
model ClipLink {
  id        String   @id @default(cuid())
  clipId    String
  clip      Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

// The owner's own social profiles, shown on Home and as contact links on the privacy page.
model ProfileLink {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

// Video guides the owner adds in Settings, listed on the Help page.
model GuideLink {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  url       String
  createdAt DateTime @default(now())
}

// The app's settings, edited on /settings: one row, id 1. The Meta app secret and the Resend API key are sealed with
// TOKEN_ENC_KEY (src/lib/settings.ts).
model Setting {
  id                Int     @id @default(1)
  metaAppId         String?
  metaAppSecret     String?
  alertEmail        String?
  resendApiKey      String?
  emailFrom         String?
  // Cloudflare R2, where a post's video is put for Instagram to download. The secret access key is sealed too.
  r2AccountId       String?
  r2AccessKeyId     String?
  r2SecretAccessKey String?
  r2Bucket          String?
}

// The H.264 encoder the worker found when it last started: the NVIDIA card's NVENC, or x264 on the processor.
model VideoEncoding {
  id        Int          @id @default(1)
  encoder   VideoEncoder
  checkedAt DateTime     @updatedAt
}

enum VideoEncoder {
  nvenc
  x264
}

enum AiEngineStatus {
  not_installed
  installing
  installed
  failed
}

// The offline AI video engine (ComfyUI and the Wan 2.2 model files in <data>\ai): one row, id 1. No row means not
// installed. While installing, the worker writes the step and the percentage every few seconds.
model AiEngine {
  id             Int            @id @default(1)
  status         AiEngineStatus @default(not_installed)
  step           String?
  percent        Int?
  error          String?
  installedBytes BigInt?
  updatedAt      DateTime       @updatedAt
}

enum AiVideoStatus {
  queued
  running
  done
  failed
}

// One AI video asked for on the Clips page. When it is done, clipId is the clip it made in the owner's "AI videos"
// project.
model AiVideoJob {
  id            String        @id @default(cuid())
  ownerId       String
  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  prompt        String
  seconds       Int
  startImageKey String?
  status        AiVideoStatus @default(queued)
  step          String?
  error         String?
  clipId        String?       @unique
  clip          Clip?         @relation(fields: [clipId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
}
