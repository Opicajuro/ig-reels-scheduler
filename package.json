{
  "name": "ig-reels-scheduler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "wizard": "tsx scripts/wizard.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@aws-sdk/client-s3": "3.1148.0",
    "@aws-sdk/s3-request-presigner": "3.1148.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "overrides": {
      "lodash": ">=4.17.24",
      "mysql2": ">=3.23.1",
      "deepmerge-ts": ">=8.0.0"
    }
  }
}
